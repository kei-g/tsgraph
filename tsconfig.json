{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationDir": ".",
    "emitDeclarationOnly": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [
      "DOM",
      "ESNext",
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "newLine": "lf",
    "pretty": true,
    "removeComments": false,
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2015",
    "types": [
      "node",
    ],
  },
  "exclude": [],
  "include": [
    "src",
  ],
}
